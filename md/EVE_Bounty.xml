<?xml version="1.0" encoding="utf-8"?>
<mdscript name="ptich_EVE_Bounty" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- CONCORD bounty: pay the player whenever they destroy a ship belonging to one of the EVE pirate factions. -->
    <cue name="BountyListener" instantiate="true">
      <conditions>
        <event_player_owned_killed_object/>
        <check_any>
          <check_value value="event.param2.owner == faction.eve_angel_cartel"/>
          <check_value value="event.param2.owner == faction.eve_blood_raiders"/>
          <check_value value="event.param2.owner == faction.eve_guristas_pirates"/>
          <check_value value="event.param2.owner == faction.eve_sanshas_nation"/>
        </check_any>
      </conditions>
      <actions>
        <set_value name="$Victim" exact="event.param2"/>
        <set_value name="$Bounty" exact="5000Cr"/>
        <do_if value="$Victim.isclass.ship_s">
          <set_value name="$Bounty" exact="18000Cr"/>
        </do_if>
        <do_elseif value="$Victim.isclass.ship_m">
          <set_value name="$Bounty" exact="125000Cr"/>
        </do_elseif>
        <do_elseif value="$Victim.isclass.ship_l">
          <set_value name="$Bounty" exact="800000Cr"/>
        </do_elseif>
        <do_elseif value="$Victim.isclass.ship_xl">
          <set_value name="$Bounty" exact="10000000Cr"/>
        </do_elseif>

        <reward_player money="$Bounty"/>
        <show_notification text="{35002,30}.[$Victim.owner.knownname, $Bounty.formatted.{'%.s %Cr'}]"/>
      </actions>
    </cue>
  </cues>
</mdscript>
