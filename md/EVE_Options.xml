<?xml version="1.0" encoding="utf-8"?>
<mdscript name="EVE_Options" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    In-game options menu for EVE Online in X4.
    Uses SirNukes Simple Menu API (dependency: ws_2042901274).
  -->
  <cues>
    <cue name="Init" instantiate="true">
      <conditions>
        <check_any>
          <event_universe_generated/>
          <event_game_loaded/>
        </check_any>
      </conditions>
      <actions>
        <do_if value="not global.$EVEonlineinX4?">
          <set_value name="global.$EVEonlineinX4" exact="table[]"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$SpawnEnabled?">
          <set_value name="global.$EVEonlineinX4.$SpawnEnabled" exact="true"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$Score?">
          <set_value name="global.$EVEonlineinX4.$Score" exact="0"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$SpawnerInitialized?">
          <set_value name="global.$EVEonlineinX4.$SpawnerInitialized" exact="false"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$RoleplayFaction?">
          <set_value name="global.$EVEonlineinX4.$RoleplayFaction" exact="faction.argon"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$RoleplayFactionIndex?">
          <set_value name="global.$EVEonlineinX4.$RoleplayFactionIndex" exact="0"/>
        </do_if>
        <debug_text text="'MOD: EVEonlineinX4 -- global state initialized. SpawnEnabled=' + global.$EVEonlineinX4.$SpawnEnabled + ' Score=' + global.$EVEonlineinX4.$Score + ' RoleplayFaction=' + global.$EVEonlineinX4.$RoleplayFaction.knownname" context="false" filter="scripts"/>
      </actions>
    </cue>

    <cue name="RegisterOptions" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Simple_Menu_API.Reloaded"/>
      </conditions>
      <actions>
        <debug_text text="'MOD: EVEonlineinX4 -- RegisterOptions fired.'" context="false" filter="scripts"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Register_Options_Menu" param="table[
            $id = 'ptich_eve_online_in_x4_options',
            $columns = 2,
            $title = 'ptich9km: EVE Online in X4',
            $onOpen = BuildOptions
          ]"/>
      </actions>
    </cue>

    <cue name="BuildOptions" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <!-- Title -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $text = 'ptich9km: EVE Online in X4',
            $titleText = true
          ]"/>

        <!-- Spawn toggle -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Enable pirate spawning',
            $mouseOverText = 'When ON, EVE pirate groups continue to spawn in Heretic\'s End. Turn OFF to stop new spawns. Already spawned groups remain.'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Toggle_SpawnEnabled,
            $text = table[
              $text = if global.$EVEonlineinX4.$SpawnEnabled then 'ON' else 'OFF',
              $color = if global.$EVEonlineinX4.$SpawnEnabled then 'Color.text_success' else 'Color.text_failure',
              $halign = 'center'
            ]
          ]"/>

        <!-- Spacer -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[$col = 1, $colSpan = 2, $text = ' ']"/>

        <!-- CONCORD score display -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $text = 'CONCORD score: ' + global.$EVEonlineinX4.$Score
          ]"/>

        <!-- Roleplay faction selector -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = '{35002,232}'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Toggle_RoleplayFaction,
            $text = table[
              $text = global.$EVEonlineinX4.$RoleplayFaction.knownname,
              $halign = 'center'
            ]
          ]"/>

        <!-- Spacer -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[$col = 1, $colSpan = 2, $text = ' ']"/>

        <!-- Support ships section -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $text = 'Call CONCORD support ship',
            $titleText = true
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Abandoned S-class warship',
            $mouseOverText = 'Cost: 10 CONCORD points'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Call_Support_S,
            $text = table[
              $text = 'Call (10 pts)',
              $halign = 'center'
            ]
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Abandoned M-class warship',
            $mouseOverText = 'Cost: 25 CONCORD points'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Call_Support_M,
            $text = table[
              $text = 'Call (25 pts)',
              $halign = 'center'
            ]
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Abandoned L-class warship',
            $mouseOverText = 'Cost: 100 CONCORD points'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Call_Support_L,
            $text = table[
              $text = 'Call (100 pts)',
              $halign = 'center'
            ]
          ]"/>
      </actions>
    </cue>

    <cue name="Toggle_SpawnEnabled" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$EVEonlineinX4.$SpawnEnabled" exact="not global.$EVEonlineinX4.$SpawnEnabled"/>
        <debug_text text="'MOD: EVEonlineinX4 -- SpawnEnabled toggled to: ' + global.$EVEonlineinX4.$SpawnEnabled" context="false" filter="scripts"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <cue name="Toggle_RoleplayFaction" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$FactionList" exact="[faction.argon, faction.paranid, faction.teladi, faction.antigone, faction.freesplit, faction.holyorder, faction.ministry, faction.pioneers, faction.scaleplate, faction.buccaneers, faction.xenon, faction.split, faction.boron, faction.terran]"/>
        <set_value name="$NextIndex" exact="(global.$EVEonlineinX4.$RoleplayFactionIndex + 1) % $FactionList.count"/>
        <set_value name="global.$EVEonlineinX4.$RoleplayFactionIndex" exact="$NextIndex"/>
        <set_value name="global.$EVEonlineinX4.$RoleplayFaction" exact="$FactionList.{$NextIndex}"/>
        <debug_text text="'MOD: EVEonlineinX4 -- RoleplayFaction toggled to: ' + global.$EVEonlineinX4.$RoleplayFaction.knownname" context="false" filter="scripts"/>
        <show_notification text="{35002,231}.[global.$EVEonlineinX4.$RoleplayFaction.knownname]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <cue name="Call_Support_S" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <signal_cue_instantly cue="Call_Support" param="table[$Size = class.ship_s, $Cost = 10]"/>
      </actions>
    </cue>

    <cue name="Call_Support_M" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <signal_cue_instantly cue="Call_Support" param="table[$Size = class.ship_m, $Cost = 25]"/>
      </actions>
    </cue>

    <cue name="Call_Support_L" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <signal_cue_instantly cue="Call_Support" param="table[$Size = class.ship_l, $Cost = 100]"/>
      </actions>
    </cue>

    <cue name="Call_Support" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Cost" exact="event.param.$Cost"/>
        <set_value name="$Size" exact="event.param.$Size"/>
        <set_value name="$SizeName" exact="if $Size == class.ship_s then 'S' else (if $Size == class.ship_m then 'M' else (if $Size == class.ship_l then 'L' else 'Unknown'))"/>

        <do_if value="global.$EVEonlineinX4.$Score lt $Cost">
          <show_notification text="{35002,226}.[global.$EVEonlineinX4.$Score, $Cost]"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_if>
        <do_else>
          <do_if value="player.occupiedship.exists and player.occupiedship.sector.exists">
            <set_value name="$Sector" exact="player.occupiedship.sector"/>
            <get_safe_pos result="$SpawnPos" sector="$Sector" object="player.occupiedship" radius="5km"/>
            <debug_text text="'MOD: EVEonlineinX4 -- Call_Support: sector=' + $Sector.knownname + ' pos=' + $SpawnPos" context="false" filter="scripts"/>

            <set_value name="$ShipFaction" exact="global.$EVEonlineinX4.$RoleplayFaction"/>
            <set_value name="$ShipDef" exact="null"/>

            <!-- Xenon ships do not use the military tag, so look for any ship of the requested size. -->
            <do_if value="$ShipFaction == faction.xenon">
              <get_ship_definition reference="$ShipDef" faction="faction.xenon" size="$Size"/>
            </do_if>
            <do_else>
              <get_ship_definition reference="$ShipDef" faction="$ShipFaction" size="$Size" tags="tag.military"/>
              <do_if value="not $ShipDef">
                <get_ship_definition reference="$ShipDef" faction="$ShipFaction" size="$Size"/>
              </do_if>
            </do_else>

            <!-- Fallback to Argon if the selected faction has no ship of this size. -->
            <do_if value="not $ShipDef">
              <get_ship_definition reference="$ShipDef" faction="faction.argon" size="$Size" tags="tag.military"/>
              <do_if value="not $ShipDef">
                <get_ship_definition reference="$ShipDef" faction="faction.argon" size="$Size"/>
              </do_if>
            </do_if>
            <debug_text text="'MOD: EVEonlineinX4 -- Call_Support: faction=' + $ShipFaction.knownname + ' shipdef=' + (if $ShipDef? then 'found' else 'NOT FOUND')" context="false" filter="scripts"/>

            <do_if value="$ShipDef?">
              <set_value name="global.$EVEonlineinX4.$Score" operation="subtract" exact="$Cost"/>

              <create_ship name="$Support" sector="$Sector" ref="$ShipDef" capturable="true">
                <owner exact="faction.ownerless"/>
                <safepos value="$SpawnPos"/>
              </create_ship>
              <debug_text text="'MOD: EVEonlineinX4 -- Call_Support: support exists=' + $Support.exists" context="false" filter="scripts"/>
              <do_if value="$Support.exists">
                <set_known object="$Support" known="true"/>
                <show_notification text="{35002,227}.[$SizeName]"/>
              </do_if>
              <do_else>
                <!-- Spawn failed: refund the CONCORD points. -->
                <set_value name="global.$EVEonlineinX4.$Score" operation="add" exact="$Cost"/>
                <show_notification text="{35002,228}"/>
              </do_else>
            </do_if>
            <do_else>
              <show_notification text="{35002,228}"/>
            </do_else>
          </do_if>
          <do_else>
            <show_notification text="{35002,229}"/>
          </do_else>

          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_else>
      </actions>
    </cue>
  </cues>
</mdscript>
