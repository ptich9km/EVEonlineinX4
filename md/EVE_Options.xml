<?xml version="1.0" encoding="utf-8"?>
<mdscript name="EVE_Options" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    In-game options menu for EVE Online in X4.
    Uses SirNukes Simple Menu API (dependency: ws_2042901274).
  -->
  <cues>
    <cue name="Init" instantiate="true">
      <conditions>
        <check_any>
          <event_universe_generated/>
          <event_game_loaded/>
        </check_any>
      </conditions>
      <actions>
        <do_if value="not global.$EVEonlineinX4?">
          <set_value name="global.$EVEonlineinX4" exact="table[]"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$SpawnEnabled?">
          <set_value name="global.$EVEonlineinX4.$SpawnEnabled" exact="true"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$Score?">
          <set_value name="global.$EVEonlineinX4.$Score" exact="0"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$SpawnerInitialized?">
          <set_value name="global.$EVEonlineinX4.$SpawnerInitialized" exact="false"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$RoleplayFaction?">
          <set_value name="global.$EVEonlineinX4.$RoleplayFaction" exact="faction.argon"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$PLEXBalance?">
          <set_value name="global.$EVEonlineinX4.$PLEXBalance" exact="0"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$GroupSizeMultiplier?">
          <set_value name="global.$EVEonlineinX4.$GroupSizeMultiplier" exact="1"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$RoleplayFactionIndex?">
          <set_value name="global.$EVEonlineinX4.$RoleplayFactionIndex" exact="0"/>
        </do_if>
        <!-- Bounty Board state -->
        <do_if value="not global.$EVEonlineinX4.$BountySubscribed?">
          <set_value name="global.$EVEonlineinX4.$BountySubscribed" exact="false"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$BountyMissions?">
          <set_value name="global.$EVEonlineinX4.$BountyMissions" exact="[]"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$BountyActiveMissions?">
          <set_value name="global.$EVEonlineinX4.$BountyActiveMissions" exact="[]"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$BountyMissionCounter?">
          <set_value name="global.$EVEonlineinX4.$BountyMissionCounter" exact="0"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$BountyLastRefresh?">
          <set_value name="global.$EVEonlineinX4.$BountyLastRefresh" exact="0s"/>
        </do_if>
        <!-- CONCORD Resource Supply selection -->
        <do_if value="not global.$EVEonlineinX4.$SupplyWareIndex?">
          <set_value name="global.$EVEonlineinX4.$SupplyWareIndex" exact="1"/>
        </do_if>
        <do_if value="not global.$EVEonlineinX4.$SupplySizeIndex?">
          <set_value name="global.$EVEonlineinX4.$SupplySizeIndex" exact="2"/>
        </do_if>
        <debug_text text="'MOD: EVEonlineinX4 -- global state initialized. SpawnEnabled=' + global.$EVEonlineinX4.$SpawnEnabled + ' Score=' + global.$EVEonlineinX4.$Score + ' RoleplayFaction=' + global.$EVEonlineinX4.$RoleplayFaction.knownname" context="false" filter="scripts"/>
      </actions>
    </cue>

    <cue name="RegisterOptions" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Simple_Menu_API.Reloaded"/>
      </conditions>
      <actions>
        <debug_text text="'MOD: EVEonlineinX4 -- RegisterOptions fired.'" context="false" filter="scripts"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Register_Options_Menu" param="table[
            $id = 'ptich_eve_online_in_x4_options',
            $columns = 2,
            $title = 'ptich9km: EVE Online in X4',
            $onOpen = BuildOptions
          ]"/>
      </actions>
    </cue>

    <cue name="BuildOptions" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <!-- Title -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $text = 'ptich9km: EVE Online in X4',
            $titleText = true
          ]"/>

        <!-- Spawn toggle -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Enable pirate spawning',
            $halign = 'right',
            $mouseOverText = 'When ON, EVE pirate groups continue to spawn in Heretic\'s End. Turn OFF to stop new spawns. Already spawned groups remain.'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_CheckBox" param="table[
            $col = 2,
            $id = 'spawn_enabled',
            $checked = global.$EVEonlineinX4.$SpawnEnabled,
            $width = 'Helper.standardButtonHeight',
            $height = 'Helper.standardButtonHeight',
            $onClick = On_SpawnEnabled_Changed,
            $mouseOverText = 'When ON, EVE pirate groups continue to spawn in Heretic\'s End. Turn OFF to stop new spawns. Already spawned groups remain.'
          ]"/>

        <!-- Spacer -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[$col = 1, $colSpan = 2, $text = ' ']"/>

        <!-- Spacer -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $height = 'Helper.borderSize',
            $fontsize = 1
          ]"/>

        <!-- PLEX section -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $text = 'PLEX Upgrades',
            $font = 'Helper.standardFontBold',
            $color = 'Helper.color.blue'
          ]"/>

        <set_value name="$Multiplier" exact="if global.$EVEonlineinX4.$GroupSizeMultiplier? then global.$EVEonlineinX4.$GroupSizeMultiplier else 1"/>
        <set_value name="$NextMultiplier" exact="if $Multiplier == 1 then 2 else (if $Multiplier == 2 then 3 else (if $Multiplier == 3 then 5 else (if $Multiplier == 5 then 10 else 10)))"/>
        <set_value name="$NextCost" exact="if $NextMultiplier == 2 then 1 else (if $NextMultiplier == 3 then 3 else (if $NextMultiplier == 5 then 6 else (if $NextMultiplier == 10 then 10 else 0)))"/>
        <set_value name="$UpgradeText" exact="if $Multiplier == 10 then 'Max reached' else 'Upgrade to x' + $NextMultiplier + ' (' + $NextCost + ' PLEX)'"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'PLEX balance: ' + global.$EVEonlineinX4.$PLEXBalance,
            $halign = 'right'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Convert_PLEX,
            $text = table[
              $text = 'Buy 1 PLEX (100M Cr)',
              $halign = 'center'
            ]
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Group size multiplier: x' + $Multiplier,
            $halign = 'right'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Upgrade_GroupSize,
            $text = table[
              $text = $UpgradeText,
              $halign = 'center'
            ]
          ]"/>

        <!-- Spacer -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $height = 'Helper.borderSize',
            $fontsize = 1
          ]"/>

        <!-- CONCORD score display -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $text = 'CONCORD score: ' + global.$EVEonlineinX4.$Score,
            $font = 'Helper.standardFontBold'
          ]"/>

        <!-- CONCORD Bounty Board -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $height = 'Helper.borderSize',
            $fontsize = 1
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $text = 'CONCORD Bounty Board',
            $font = 'Helper.standardFontBold',
            $color = 'Helper.color.blue'
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = if global.$EVEonlineinX4.$BountySubscribed then 'Bounty program active' else 'Not subscribed',
            $halign = 'right'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = if global.$EVEonlineinX4.$BountySubscribed then Bounty_Leave else Bounty_Join,
            $text = table[
              $text = if global.$EVEonlineinX4.$BountySubscribed then 'Leave' else 'Join',
              $halign = 'center',
              $color = if global.$EVEonlineinX4.$BountySubscribed then 'Color.text_failure' else 'Color.text_success'
            ]
          ]"/>

        <do_if value="global.$EVEonlineinX4.$BountySubscribed">
          <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
              $col = 1, $colSpan = 2,
              $text = 'Available missions',
              $font = 'Helper.standardFontBold',
              $color = 'Helper.color.blue'
            ]"/>
          <do_if value="global.$EVEonlineinX4.$BountyMissions.count == 0">
            <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
            <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
                $col = 1, $colSpan = 2,
                $text = 'No missions available. New offers appear soon.'
              ]"/>
          </do_if>
          <do_else>
            <do_for_each name="$Mission" in="global.$EVEonlineinX4.$BountyMissions">
              <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
              <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
                  $col = 1,
                  $text = $Mission.$Description + '\nReward: ' + $Mission.$Reward + ' CONCORD points'
                ]"/>
              <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
                  $col = 2,
                  $onClick = Bounty_Take_Mission,
                  $echo = table[$MissionID = $Mission.$ID],
                  $text = table[
                    $text = 'Take',
                    $color = 'Color.text_success',
                    $halign = 'center'
                  ]
                ]"/>
            </do_for_each>
          </do_else>

          <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
              $col = 1, $colSpan = 2,
              $text = 'Active missions',
              $font = 'Helper.standardFontBold',
              $color = 'Helper.color.blue'
            ]"/>
          <do_if value="global.$EVEonlineinX4.$BountyActiveMissions.count == 0">
            <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
            <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
                $col = 1, $colSpan = 2,
                $text = '—'
              ]"/>
          </do_if>
          <do_else>
            <do_for_each name="$Mission" in="global.$EVEonlineinX4.$BountyActiveMissions">
              <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
              <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
                  $col = 1,
                  $text = $Mission.$Description + '\nProgress: ' + $Mission.$Progress + ' / ' + $Mission.$Target
                ]"/>
              <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
                  $col = 2,
                  $text = 'Reward: ' + $Mission.$Reward + ' pts',
                  $halign = 'center'
                ]"/>
            </do_for_each>
          </do_else>
        </do_if>

        <!-- Roleplay faction selector -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $text = 'Roleplay faction',
            $font = 'Helper.standardFontBold',
            $color = 'Helper.color.blue'
          ]"/>

        <set_value name="$FactionOptions" exact="[
          table[$text = 'Argon',     $faction = faction.argon],
          table[$text = 'Paranid',   $faction = faction.paranid],
          table[$text = 'Teladi',    $faction = faction.teladi],
          table[$text = 'Antigone',  $faction = faction.antigone],
          table[$text = 'Free Split',$faction = faction.freesplit],
          table[$text = 'Holy Order',$faction = faction.holyorder],
          table[$text = 'Ministry',  $faction = faction.ministry],
          table[$text = 'Pioneers',  $faction = faction.pioneers],
          table[$text = 'Scale Plate',$faction = faction.scaleplate],
          table[$text = 'Buccaneers',$faction = faction.buccaneers],
          table[$text = 'Xenon',     $faction = faction.xenon],
          table[$text = 'Split',     $faction = faction.split],
          table[$text = 'Boron',     $faction = faction.boron],
          table[$text = 'Terran',    $faction = faction.terran]
        ]"/>
        <set_value name="$FactionIndex" exact="0"/>
        <do_all exact="$FactionOptions.count" counter="$fi">
          <do_if value="$FactionOptions.{$fi}.$faction == global.$EVEonlineinX4.$RoleplayFaction">
            <set_value name="$FactionIndex" exact="$fi"/>
          </do_if>
        </do_all>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Roleplay faction',
            $halign = 'right',
            $mouseOverText = 'Faction used for CONCORD support ship hulls. Xenon and DLC factions fall back to Argon if the hull is unavailable.'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Dropdown" param="table[
            $col = 2,
            $id = 'roleplay_faction',
            $options = $FactionOptions,
            $startOption = $FactionIndex,
            $onDropDownConfirmed = On_RoleplayFaction_Changed,
            $mouseOverText = 'Faction used for CONCORD support ship hulls. Xenon and DLC factions fall back to Argon if the hull is unavailable.'
          ]"/>

        <!-- Spacer -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $height = 'Helper.borderSize',
            $fontsize = 1
          ]"/>

        <!-- Support ships section -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $text = 'Call CONCORD support ship',
            $font = 'Helper.standardFontBold',
            $color = 'Helper.color.blue'
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Abandoned S-class warship',
            $halign = 'right',
            $mouseOverText = 'Cost: 10 CONCORD points'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Call_Support_S,
            $text = table[
              $text = 'Call (10 pts)',
              $halign = 'center'
            ]
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Abandoned M-class warship',
            $halign = 'right',
            $mouseOverText = 'Cost: 25 CONCORD points'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Call_Support_M,
            $text = table[
              $text = 'Call (25 pts)',
              $halign = 'center'
            ]
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Abandoned L-class warship',
            $halign = 'right',
            $mouseOverText = 'Cost: 100 CONCORD points'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Call_Support_L,
            $text = table[
              $text = 'Call (100 pts)',
              $halign = 'center'
            ]
          ]"/>

        <!-- Spacer -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $height = 'Helper.borderSize',
            $fontsize = 1
          ]"/>

        <!-- CONCORD Resource Supply: buy cargo delivered in an abandoned hauler -->
        <!-- Prices are integer CONC points: per-1k-unit price (market x1.5 at 500k Cr/point, rounded up) + hauler cost. -->
        <set_value name="$SupplyWares" exact="[
          table[$text = 'Energy Cells',     $ware = ware.energycells,    $perk = 1],
          table[$text = 'Ore',              $ware = ware.ore,            $perk = 1],
          table[$text = 'Silicon Wafers',   $ware = ware.siliconwafers,  $perk = 1],
          table[$text = 'Ice',              $ware = ware.ice,            $perk = 1],
          table[$text = 'Food Rations',     $ware = ware.foodrations,    $perk = 1],
          table[$text = 'Composites',       $ware = ware.composites,     $perk = 4],
          table[$text = 'Hull Parts',       $ware = ware.hullparts,      $perk = 5],
          table[$text = 'Claytronics',      $ware = ware.claytronics,    $perk = 12],
          table[$text = 'Nividium',         $ware = ware.nividium,       $perk = 105]
        ]"/>
        <set_value name="$SupplySizes" exact="[
          table[$text = 'Small (1,000 units)',  $amount = 1000, $kmul = 1, $shipcost = 8],
          table[$text = 'Medium (3,000 units)', $amount = 3000, $kmul = 3, $shipcost = 20],
          table[$text = 'Large (8,000 units)',  $amount = 8000, $kmul = 8, $shipcost = 80]
        ]"/>
        <set_value name="$WareIdx" exact="if global.$EVEonlineinX4.$SupplyWareIndex? then global.$EVEonlineinX4.$SupplyWareIndex else 1"/>
        <set_value name="$SizeIdx" exact="if global.$EVEonlineinX4.$SupplySizeIndex? then global.$EVEonlineinX4.$SupplySizeIndex else 2"/>
        <set_value name="$SupplyCost" exact="$SupplyWares.{$WareIdx}.$perk * $SupplySizes.{$SizeIdx}.$kmul + $SupplySizes.{$SizeIdx}.$shipcost"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1, $colSpan = 2,
            $text = 'CONCORD Resource Supply',
            $font = 'Helper.standardFontBold',
            $color = 'Helper.color.blue'
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Resource',
            $halign = 'right',
            $mouseOverText = 'Cargo ware delivered by an abandoned CONCORD hauler next to your ship. The hauler is yours to keep.'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Dropdown" param="table[
            $col = 2,
            $id = 'supply_ware',
            $options = $SupplyWares,
            $startOption = $WareIdx,
            $onDropDownConfirmed = On_SupplyWare_Changed,
            $mouseOverText = 'Cargo ware delivered by an abandoned CONCORD hauler next to your ship. The hauler is yours to keep.'
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Shipment size',
            $halign = 'right',
            $mouseOverText = 'Larger shipments need a bigger hauler and cost more.'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Dropdown" param="table[
            $col = 2,
            $id = 'supply_size',
            $options = $SupplySizes,
            $startOption = $SizeIdx,
            $onDropDownConfirmed = On_SupplySize_Changed,
            $mouseOverText = 'Larger shipments need a bigger hauler and cost more.'
          ]"/>

        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
            $col = 1,
            $text = 'Cost: ' + $SupplyCost + ' CONCORD points (cargo + hauler)',
            $halign = 'right',
            $mouseOverText = 'Price includes the cargo at a 50% markup over market plus the hauler, which stays with you.'
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
            $col = 2,
            $onClick = Order_Supply,
            $text = table[
              $text = 'Order (' + $SupplyCost + ' pts)',
              $halign = 'center'
            ]
          ]"/>
      </actions>
    </cue>

    <cue name="On_SpawnEnabled_Changed" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$EVEonlineinX4.$SpawnEnabled" exact="event.param.$checked"/>
        <debug_text text="'MOD: EVEonlineinX4 -- SpawnEnabled changed to: ' + global.$EVEonlineinX4.$SpawnEnabled" context="false" filter="scripts"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <cue name="On_RoleplayFaction_Changed" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$EVEonlineinX4.$RoleplayFaction" exact="event.param.$option.$faction"/>
        <set_value name="global.$EVEonlineinX4.$RoleplayFactionIndex" exact="event.param.$option_index - 1"/>
        <debug_text text="'MOD: EVEonlineinX4 -- RoleplayFaction changed to: ' + global.$EVEonlineinX4.$RoleplayFaction.knownname" context="false" filter="scripts"/>
        <show_notification text="{35002,231}.[global.$EVEonlineinX4.$RoleplayFaction.knownname]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <cue name="Call_Support_S" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <signal_cue_instantly cue="Call_Support" param="table[$Size = class.ship_s, $Cost = 10]"/>
      </actions>
    </cue>

    <cue name="Call_Support_M" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <signal_cue_instantly cue="Call_Support" param="table[$Size = class.ship_m, $Cost = 25]"/>
      </actions>
    </cue>

    <cue name="Call_Support_L" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <signal_cue_instantly cue="Call_Support" param="table[$Size = class.ship_l, $Cost = 100]"/>
      </actions>
    </cue>

    <cue name="Convert_PLEX" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <do_if value="player.money lt 100000000Cr">
          <show_notification text="{35002,303}.[player.money.formatted.{'%.s %Cr'}]"/>
        </do_if>
        <do_else>
          <set_value name="player.money" operation="subtract" exact="100000000Cr"/>
          <set_value name="global.$EVEonlineinX4.$PLEXBalance" operation="add" exact="1"/>
          <show_notification text="{35002,304}"/>
        </do_else>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <cue name="Upgrade_GroupSize" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Multiplier" exact="if global.$EVEonlineinX4.$GroupSizeMultiplier? then global.$EVEonlineinX4.$GroupSizeMultiplier else 1"/>
        <set_value name="$NextMultiplier" exact="if $Multiplier == 1 then 2 else (if $Multiplier == 2 then 3 else (if $Multiplier == 3 then 5 else (if $Multiplier == 5 then 10 else 10)))"/>
        <set_value name="$NextCost" exact="if $NextMultiplier == 2 then 1 else (if $NextMultiplier == 3 then 3 else (if $NextMultiplier == 5 then 6 else (if $NextMultiplier == 10 then 10 else 0)))"/>

        <do_if value="$Multiplier == 10">
          <show_notification text="{35002,312}"/>
        </do_if>
        <do_elseif value="global.$EVEonlineinX4.$PLEXBalance lt $NextCost">
          <show_notification text="{35002,313}.[global.$EVEonlineinX4.$PLEXBalance, $NextCost]"/>
        </do_elseif>
        <do_else>
          <set_value name="global.$EVEonlineinX4.$PLEXBalance" operation="subtract" exact="$NextCost"/>
          <set_value name="global.$EVEonlineinX4.$GroupSizeMultiplier" exact="$NextMultiplier"/>
          <show_notification text="{35002,314}.[$NextMultiplier]"/>
        </do_else>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <cue name="Call_Support" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Cost" exact="event.param.$Cost"/>
        <set_value name="$Size" exact="event.param.$Size"/>
        <set_value name="$SizeName" exact="if $Size == class.ship_s then 'S' else (if $Size == class.ship_m then 'M' else (if $Size == class.ship_l then 'L' else 'Unknown'))"/>

        <do_if value="global.$EVEonlineinX4.$Score lt $Cost">
          <show_notification text="{35002,226}.[global.$EVEonlineinX4.$Score, $Cost]"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_if>
        <do_else>
          <do_if value="player.occupiedship.exists and player.occupiedship.sector.exists">
            <set_value name="$Sector" exact="player.occupiedship.sector"/>
            <get_safe_pos result="$SpawnPos" sector="$Sector" object="player.occupiedship" radius="5km"/>
            <debug_text text="'MOD: EVEonlineinX4 -- Call_Support: sector=' + $Sector.knownname + ' pos=' + $SpawnPos" context="false" filter="scripts"/>

            <set_value name="$ShipFaction" exact="global.$EVEonlineinX4.$RoleplayFaction"/>
            <set_value name="$ShipDef" exact="null"/>

            <!-- Xenon: only a few hulls can be piloted by the player. Pick the allowed one by size. -->
            <do_if value="$ShipFaction == faction.xenon">
              <set_value name="$XenonMacro" exact="null"/>
              <set_value name="$Paintmod" exact="null"/>
              <do_if value="$Size == class.ship_s">
                <set_value name="$XenonMacro" exact="'ship_xen_s_heavyfighter_01_a_macro'"/>
                <set_value name="$Paintmod" exact="ware.paintmod_0153"/>
              </do_if>
              <do_elseif value="$Size == class.ship_m">
                <set_value name="$R" min="1" max="100"/>
                <set_value name="$XenonMacro" exact="if $R le 50 then 'ship_xen_m_corvette_01_a_macro' else 'ship_xen_m_corvette_02_a_macro'"/>
                <set_value name="$Paintmod" exact="ware.paintmod_0158"/>
              </do_elseif>
              <do_elseif value="$Size == class.ship_l">
                <set_value name="$XenonMacro" exact="'ship_xen_l_terraformer_01_a_macro'"/>
                <set_value name="$Paintmod" exact="ware.paintmod_0150"/>
              </do_elseif>

              <do_if value="$XenonMacro?">
                <create_ship name="$Support" sector="$Sector" macro="$XenonMacro" capturable="true">
                  <owner exact="faction.ownerless"/>
                  <loadout>
                    <level exact="1.0" faction="faction.xenon"/>
                  </loadout>
                  <paint ware="$Paintmod"/>
                  <pilot actor="null"/>
                  <safepos value="$SpawnPos"/>
                  <rotation yaw="[-90deg,90deg].randominrange" roll="[-8deg,8deg].randominrange"/>
                </create_ship>
                <debug_text text="'MOD: EVEonlineinX4 -- Call_Support: Xenon macro=' + $XenonMacro + ' exists=' + $Support.exists" context="false" filter="scripts"/>

                <do_if value="$Support.exists">
                  <set_value name="$Hull" min="50" max="80"/>
                  <set_object_hull object="$Support" exact="$Hull"/>
                  <set_known object="$Support" known="true"/>
                  <set_value name="global.$EVEonlineinX4.$Score" operation="subtract" exact="$Cost"/>
                  <show_notification text="{35002,227}.[$SizeName]"/>
                </do_if>
                <do_else>
                  <show_notification text="{35002,228}"/>
                </do_else>
              </do_if>
              <do_else>
                <show_notification text="{35002,228}"/>
              </do_else>
            </do_if>
            <do_elseif value="$ShipFaction != faction.xenon">
              <get_ship_definition reference="$ShipDef" faction="$ShipFaction" size="$Size" tags="tag.military"/>
              <do_if value="not $ShipDef">
                <get_ship_definition reference="$ShipDef" faction="$ShipFaction" size="$Size"/>
              </do_if>

              <!-- Fallback to Argon if the selected faction has no ship of this size. -->
              <do_if value="not $ShipDef">
                <get_ship_definition reference="$ShipDef" faction="faction.argon" size="$Size" tags="tag.military"/>
                <do_if value="not $ShipDef">
                  <get_ship_definition reference="$ShipDef" faction="faction.argon" size="$Size"/>
                </do_if>
              </do_if>
              <debug_text text="'MOD: EVEonlineinX4 -- Call_Support: faction=' + $ShipFaction.knownname + ' shipdef=' + (if $ShipDef? then 'found' else 'NOT FOUND')" context="false" filter="scripts"/>

              <do_if value="$ShipDef?">
                <create_ship name="$Support" sector="$Sector" ref="$ShipDef" capturable="true">
                  <owner exact="faction.ownerless"/>
                  <loadout>
                    <level exact="1.0" faction="$ShipFaction"/>
                  </loadout>
                  <pilot actor="null"/>
                  <safepos value="$SpawnPos"/>
                </create_ship>
                <debug_text text="'MOD: EVEonlineinX4 -- Call_Support: support exists=' + $Support.exists" context="false" filter="scripts"/>
                <do_if value="$Support.exists">
                  <set_known object="$Support" known="true"/>
                  <set_value name="global.$EVEonlineinX4.$Score" operation="subtract" exact="$Cost"/>
                  <show_notification text="{35002,227}.[$SizeName]"/>
                </do_if>
                <do_else>
                  <show_notification text="{35002,228}"/>
                </do_else>
              </do_if>
              <do_else>
                <show_notification text="{35002,228}"/>
              </do_else>
            </do_elseif>
          </do_if>
          <do_else>
            <show_notification text="{35002,229}"/>
          </do_else>

          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_else>
      </actions>
    </cue>

    <!-- CONCORD Resource Supply: dropdown callbacks -->
    <cue name="On_SupplyWare_Changed" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$EVEonlineinX4.$SupplyWareIndex" exact="event.param.$option_index"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <cue name="On_SupplySize_Changed" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$EVEonlineinX4.$SupplySizeIndex" exact="event.param.$option_index"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <!-- CONCORD Resource Supply: order a cargo hauler like the vanilla war-subscription reward -->
    <cue name="Order_Supply" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$WareIdx" exact="if global.$EVEonlineinX4.$SupplyWareIndex? then global.$EVEonlineinX4.$SupplyWareIndex else 1"/>
        <set_value name="$SizeIdx" exact="if global.$EVEonlineinX4.$SupplySizeIndex? then global.$EVEonlineinX4.$SupplySizeIndex else 2"/>
        <set_value name="$SupplyWares" exact="[
          table[$text = 'Energy Cells',     $ware = ware.energycells,    $perk = 1],
          table[$text = 'Ore',              $ware = ware.ore,            $perk = 1],
          table[$text = 'Silicon Wafers',   $ware = ware.siliconwafers,  $perk = 1],
          table[$text = 'Ice',              $ware = ware.ice,            $perk = 1],
          table[$text = 'Food Rations',     $ware = ware.foodrations,    $perk = 1],
          table[$text = 'Composites',       $ware = ware.composites,     $perk = 4],
          table[$text = 'Hull Parts',       $ware = ware.hullparts,      $perk = 5],
          table[$text = 'Claytronics',      $ware = ware.claytronics,    $perk = 12],
          table[$text = 'Nividium',         $ware = ware.nividium,       $perk = 105]
        ]"/>
        <set_value name="$SupplySizes" exact="[
          table[$text = 'Small (1,000 units)',  $amount = 1000, $kmul = 1, $shipcost = 8],
          table[$text = 'Medium (3,000 units)', $amount = 3000, $kmul = 3, $shipcost = 20],
          table[$text = 'Large (8,000 units)',  $amount = 8000, $kmul = 8, $shipcost = 80]
        ]"/>
        <set_value name="$Ware" exact="$SupplyWares.{$WareIdx}.$ware"/>
        <set_value name="$Amount" exact="$SupplySizes.{$SizeIdx}.$amount"/>
        <set_value name="$Cost" exact="$SupplyWares.{$WareIdx}.$perk * $SupplySizes.{$SizeIdx}.$kmul + $SupplySizes.{$SizeIdx}.$shipcost"/>

        <do_if value="global.$EVEonlineinX4.$Score lt $Cost">
          <show_notification text="{35002,226}.[global.$EVEonlineinX4.$Score, $Cost]"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_if>
        <do_else>
          <do_if value="player.occupiedship.exists and player.occupiedship.sector.exists">
            <set_value name="$Sector" exact="player.occupiedship.sector"/>
            <get_safe_pos result="$SpawnPos" sector="$Sector" object="player.occupiedship" radius="5km"/>

            <!-- Vanilla approach: pick a hauler whose cargo bay fits the shipment (x4ep1 war missions). -->
            <set_value name="$shipcargo" exact="[[$Amount, $Ware]]"/>
            <run_actions ref="md.LIB_Generic.FindShipMacroForCargo" result="$ShipDef">
              <param name="shipcargo" value="$shipcargo"/>
              <param name="Faction" value="faction.argon"/>
            </run_actions>

            <do_if value="$ShipDef?">
              <create_ship name="$Support" sector="$Sector" ref="$ShipDef" capturable="true">
                <owner exact="faction.ownerless"/>
                <loadout>
                  <level exact="1.0" faction="faction.argon"/>
                </loadout>
                <pilot actor="null"/>
                <safepos value="$SpawnPos"/>
              </create_ship>
              <debug_text text="'MOD: EVEonlineinX4 -- Order_Supply: ship exists=' + $Support.exists" context="false" filter="scripts"/>

              <do_if value="$Support.exists">
                <add_cargo object="$Support" ware="$Ware" exact="$Amount"/>
                <set_known object="$Support" known="true"/>
                <set_value name="global.$EVEonlineinX4.$Score" operation="subtract" exact="$Cost"/>
                <show_notification text="{35002,342}"/>
              </do_if>
              <do_else>
                <show_notification text="{35002,343}"/>
              </do_else>
            </do_if>
            <do_else>
              <show_notification text="{35002,343}"/>
            </do_else>
          </do_if>
          <do_else>
            <show_notification text="{35002,229}"/>
          </do_else>

          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_else>
      </actions>
    </cue>

    <!-- CONCORD Bounty Board: subscription -->
    <cue name="Bounty_Join" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$EVEonlineinX4.$BountySubscribed" exact="true"/>
        <signal_cue_instantly cue="Generate_Bounty_Missions"/>
        <show_notification text="{35002,341}"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <cue name="Bounty_Leave" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$EVEonlineinX4.$BountySubscribed" exact="false"/>
        <set_value name="global.$EVEonlineinX4.$BountyMissions" exact="[]"/>
        <set_value name="global.$EVEonlineinX4.$BountyActiveMissions" exact="[]"/>
        <show_notification text="{35002,333}"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <!-- CONCORD Bounty Board: take / decline available missions -->
    <cue name="Bounty_Take_Mission" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$MissionID" exact="event.param.$echo.$MissionID"/>
        <set_value name="$TakenMission" exact="null"/>
        <set_value name="$NewAvailable" exact="[]"/>
        <do_for_each name="$Mission" in="global.$EVEonlineinX4.$BountyMissions">
          <do_if value="$Mission.$ID == $MissionID">
            <set_value name="$TakenMission" exact="$Mission"/>
          </do_if>
          <do_else>
            <append_to_list name="$NewAvailable" exact="$Mission"/>
          </do_else>
        </do_for_each>
        <do_if value="$TakenMission?">
          <append_to_list name="global.$EVEonlineinX4.$BountyActiveMissions" exact="table[
            $ID = $TakenMission.$ID,
            $Type = $TakenMission.$Type,
            $Class = $TakenMission.$Class,
            $Target = $TakenMission.$Target,
            $Progress = 0,
            $Reward = $TakenMission.$Reward,
            $Description = $TakenMission.$Description,
            $IsOfficer = $TakenMission.$IsOfficer
          ]"/>
          <set_value name="global.$EVEonlineinX4.$BountyMissions" exact="$NewAvailable"/>
        </do_if>
        <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
      </actions>
    </cue>

    <!-- CONCORD Bounty Board: auto-refresh ticker -->
    <cue name="Bounty_Mission_Ticker" instantiate="true" checktime="30m" checkinterval="30m">
      <conditions>
        <check_value value="global.$EVEonlineinX4.$BountySubscribed"/>
      </conditions>
      <actions>
        <signal_cue_instantly cue="Generate_Bounty_Missions"/>
      </actions>
    </cue>

    <!-- Library: generate / refresh available bounty missions -->
    <cue name="Generate_Bounty_Missions" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <!-- Remove expired available missions -->
        <set_value name="$Fresh" exact="[]"/>
        <set_value name="$Now" exact="player.age"/>
        <do_for_each name="$Mission" in="global.$EVEonlineinX4.$BountyMissions">
          <do_if value="$Mission.$Expires gt $Now">
            <append_to_list name="$Fresh" exact="$Mission"/>
          </do_if>
          <do_else>
            <show_notification text="{35002,332}"/>
          </do_else>
        </do_for_each>
        <set_value name="global.$EVEonlineinX4.$BountyMissions" exact="$Fresh"/>

        <!-- Build a set of active mission IDs to avoid duplicates -->
        <set_value name="$ActiveIDs" exact="table[]"/>
        <do_for_each name="$Mission" in="global.$EVEonlineinX4.$BountyActiveMissions">
          <set_value name="$ActiveIDs.{$Mission.$ID}" exact="true"/>
        </do_for_each>

        <!-- Fill up to 4 available missions -->
        <do_while value="global.$EVEonlineinX4.$BountyMissions.count lt 4">
          <set_value name="$MissionID" exact="global.$EVEonlineinX4.$BountyMissionCounter + 1"/>
          <set_value name="global.$EVEonlineinX4.$BountyMissionCounter" exact="$MissionID"/>
          <set_value name="$TypeRoll" min="1" max="100"/>

          <set_value name="$Type" exact="'kill_any'"/>
          <set_value name="$Class" exact="null"/>
          <set_value name="$Target" exact="3"/>
          <set_value name="$Reward" exact="1"/>
          <set_value name="$IsOfficer" exact="false"/>
          <set_value name="$Description" exact="'Destroy ' + 3 + ' EVE pirate ships'"/>

          <do_if value="$TypeRoll le 20">
            <set_value name="$Type" exact="'kill_s'"/>
            <set_value name="$Class" exact="class.ship_s"/>
            <set_value name="$Target" exact="[3,5].random"/>
            <set_value name="$Reward" exact="1 + $Target / 2"/>
            <set_value name="$Description" exact="'Destroy ' + $Target + ' EVE pirate S ships'"/>
          </do_if>
          <do_elseif value="$TypeRoll le 40">
            <set_value name="$Type" exact="'kill_m'"/>
            <set_value name="$Class" exact="class.ship_m"/>
            <set_value name="$Target" exact="[2,4].random"/>
            <set_value name="$Reward" exact="2 + $Target"/>
            <set_value name="$Description" exact="'Destroy ' + $Target + ' EVE pirate M ships'"/>
          </do_elseif>
          <do_elseif value="$TypeRoll le 55">
            <set_value name="$Type" exact="'kill_l'"/>
            <set_value name="$Class" exact="class.ship_l"/>
            <set_value name="$Target" exact="[1,2].random"/>
            <set_value name="$Reward" exact="4 + $Target * 2"/>
            <set_value name="$Description" exact="'Destroy ' + $Target + ' EVE pirate L ships'"/>
          </do_elseif>
          <do_elseif value="$TypeRoll le 65">
            <set_value name="$Type" exact="'kill_xl'"/>
            <set_value name="$Class" exact="class.ship_xl"/>
            <set_value name="$Target" exact="1"/>
            <set_value name="$Reward" exact="10"/>
            <set_value name="$Description" exact="'Destroy 1 EVE pirate XL ship'"/>
          </do_elseif>
          <do_elseif value="$TypeRoll le 80">
            <set_value name="$Type" exact="'kill_group'"/>
            <set_value name="$Target" exact="1"/>
            <set_value name="$Reward" exact="5"/>
            <set_value name="$Description" exact="'Destroy an EVE pirate group'"/>
          </do_elseif>
          <do_elseif value="$TypeRoll le 95">
            <set_value name="$Type" exact="'kill_any'"/>
            <set_value name="$Target" exact="[3,7].random"/>
            <set_value name="$Reward" exact="1 + $Target / 2"/>
            <set_value name="$Description" exact="'Destroy ' + $Target + ' EVE pirate ships'"/>
          </do_elseif>
          <do_else>
            <set_value name="$Type" exact="'kill_officer'"/>
            <set_value name="$IsOfficer" exact="true"/>
            <set_value name="$Target" exact="1"/>
            <set_value name="$Reward" exact="15"/>
            <set_value name="$Description" exact="'Destroy an EVE officer fleet'"/>
          </do_else>

          <do_if value="$ActiveIDs.{$MissionID}?">
            <!-- ID collision with active mission; skip this iteration -->
          </do_if>
          <do_else>
            <append_to_list name="global.$EVEonlineinX4.$BountyMissions" exact="table[
              $ID = $MissionID,
              $Type = $Type,
              $Class = $Class,
              $Target = $Target,
              $Reward = $Reward,
              $Description = $Description,
              $IsOfficer = $IsOfficer,
              $Expires = player.age + 2h
            ]"/>
          </do_else>
        </do_while>

        <set_value name="global.$EVEonlineinX4.$BountyLastRefresh" exact="player.age"/>
        <show_notification text="{35002,339}"/>
      </actions>
    </cue>

    <!-- Library: update active bounty missions from external kills -->
    <cue name="Bounty_Update_Progress" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Class" exact="event.param.$Class"/>
        <set_value name="$IsGroup" exact="if event.param.$IsGroup? then event.param.$IsGroup else false"/>
        <set_value name="$IsOfficer" exact="if event.param.$IsOfficer? then event.param.$IsOfficer else false"/>

        <set_value name="$Updated" exact="false"/>
        <set_value name="$NewActive" exact="[]"/>
        <set_value name="$Completed" exact="[]"/>

        <do_for_each name="$Mission" in="global.$EVEonlineinX4.$BountyActiveMissions">
          <set_value name="$Progressed" exact="false"/>
          <do_if value="$Mission.$Type == 'kill_any'">
            <set_value name="$Progressed" exact="true"/>
          </do_if>
          <do_elseif value="$Mission.$Type == 'kill_group' and $IsGroup">
            <set_value name="$Progressed" exact="true"/>
          </do_elseif>
          <do_elseif value="$Mission.$Type == 'kill_officer' and $IsOfficer">
            <set_value name="$Progressed" exact="true"/>
          </do_elseif>
          <do_elseif value="$Mission.$Class? and $Class == $Mission.$Class">
            <set_value name="$Progressed" exact="true"/>
          </do_elseif>

          <do_if value="$Progressed">
            <set_value name="$Mission.$Progress" operation="add" exact="1"/>
            <set_value name="$Updated" exact="true"/>
            <do_if value="$Mission.$Progress ge $Mission.$Target">
              <append_to_list name="$Completed" exact="$Mission"/>
            </do_if>
            <do_else>
              <append_to_list name="$NewActive" exact="$Mission"/>
            </do_else>
          </do_if>
          <do_else>
            <append_to_list name="$NewActive" exact="$Mission"/>
          </do_else>
        </do_for_each>

        <do_for_each name="$Mission" in="$Completed">
          <set_value name="global.$EVEonlineinX4.$Score" operation="add" exact="$Mission.$Reward"/>
          <show_notification text="{35002,331}.[$Mission.$Reward]"/>
        </do_for_each>

        <set_value name="global.$EVEonlineinX4.$BountyActiveMissions" exact="$NewActive"/>
      </actions>
    </cue>
  </cues>
</mdscript>
